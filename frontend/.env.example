# ------------------------------------------------------------------ #
# Lumina Frontend — Environment Variables                           #
# Copy to .env.local for local development                          #
# In production (Vercel), set these in the Vercel dashboard         #
# ------------------------------------------------------------------ #

# Backend API base URL
# Local dev: leave empty (Vite proxy handles it)
# Production: https://your-railway-app.up.railway.app
VITE_API_BASE=

# Default Canvas URL (pre-fills the login form)
VITE_CANVAS_URL=https://dwight.instructure.com
