# ================================================================
# Lumina Backend — Railway Variables
# Copy this to .env for local dev. Never commit .env to git.
# All of these go into Railway → Variables in production.
# ================================================================

# ----------------------------------------------------------------
# Supabase
# Dashboard → Project Settings → API
# ----------------------------------------------------------------
SUPABASE_URL=https://tnholnjrhnnqytmpqacb.supabase.co
SUPABASE_SERVICE_KEY=          # use service_role key (not anon key)

# ----------------------------------------------------------------
# Auth
# Generate JWT_SECRET:     openssl rand -hex 32
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ----------------------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRE_MINUTES=10080       # 7 days
REFRESH_EXPIRE_DAYS=90

# ----------------------------------------------------------------
# AI Provider — set AI_PROVIDER to switch. No code changes needed.
# ----------------------------------------------------------------
AI_PROVIDER=gemini              # k2 | openrouter | anthropic | nvidia | groq | gemini

# K2-Think-v2 (direct)
K2_API_KEY=
K2_API_URL=https://api.k2think.ai/v1/chat/completions
K2_MODEL=MBZUAI-IFM/K2-Think-v2

# OpenRouter (K2 + other models via one key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=MBZUAI-IFM/K2-Think-v2

# Anthropic direct (compliance path)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-r1-0528

# Groq (LPU — fast). Free tier: 12,000 TPM.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (Google AI Studio) — currently the default provider.
# Get a key at https://aistudio.google.com — same key covers embeddings below.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash-lite

# ----------------------------------------------------------------
# Embeddings — Gemini embedding API, no local model
# ----------------------------------------------------------------
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768

# ----------------------------------------------------------------
# Email — Resend
# https://resend.com/api-keys
# ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Lumina <noreply@lumina.school>

# ----------------------------------------------------------------
# Canvas
# ----------------------------------------------------------------
CANVAS_BASE_URL=https://dwight.instructure.com

# ----------------------------------------------------------------
# Server
# ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Used to build the password-reset email link. Falls back to the first
# ALLOWED_ORIGINS entry if unset — override explicitly once that origin
# stops being the same as the frontend's public URL.
FRONTEND_URL=http://localhost:5173
